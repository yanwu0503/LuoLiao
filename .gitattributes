# 统一行尾，避免 Windows 克隆下来整个仓库都显示为「已修改」
* text=auto eol=lf

# Kotlin / Gradle / 文档按文本处理
*.kt   text eol=lf
*.kts  text eol=lf
*.java text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.pro  text eol=lf
*.properties text eol=lf

# 二进制，不做行尾转换
*.jks  binary
*.keystore binary
*.jar  binary
*.png  binary
*.jpg  binary
*.webp binary

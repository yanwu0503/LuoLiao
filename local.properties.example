# 复制本文件为 local.properties 后按自己的环境填写。
# local.properties 已在 .gitignore 中，不会被提交。

# Android SDK 路径（Windows 注意用双反斜杠或正斜杠）
sdk.dir=C:/Users/你的用户名/AppData/Local/Android/Sdk

# ---- release 签名凭据 ----
# 这几项用于 app/build.gradle.kts 的 signingConfigs.release。
# 不用 release 签名（例如只跑 assembleDebug / assembleDebug 变体）时可以留空。
LUOLIAO_STORE_FILE=luoliao.jks
LUOLIAO_STORE_PASSWORD=
LUOLIAO_KEY_ALIAS=luoliao
LUOLIAO_KEY_PASSWORD=
